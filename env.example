# App
NODE_ENV=development
PORT=5000
# ─── DATABASE ─────────────────────────────────────────
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-db-password
DB_NAME=digimar_db

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=ganti-dengan-string-random-panjang
ADMIN_SETUP_KEY=ganti-ini-juga

# ─── BASE URL (untuk link reset password di email) ────
BASE_URL=https://diecastku.vercel.app

# ─── SMTP (Email) ─────────────────────────────────────
# Syarat: aktifkan "App Password" di Google Account
# (bukan password biasa, buat di: myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emailkamu@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # ← App Password dari Google (16 karakter)
SMTP_FROM_NAME=Diecastku